---
import CourseLayout from '../layouts/CourseLayout.astro';

const page = { page: "home" };
const title = "IGCSE Islamiyat";
const footerHtml = "Cambridge IGCSE Islamiyat 0493 &middot; Sources: Qur&rsquo;an, Sahih al-Bukhari, Sahih Muslim, Yasir Qadhi&rsquo;s <em>An Introduction to the Sciences of the Qur&rsquo;aan</em>, and the 2021&ndash;2025 past-paper archive";
const mainHtml = "<header class=\"hero\">\r\n        <div class=\"wrap\">\r\n          <p class=\"eyebrow\">Cambridge IGCSE &nbsp;·&nbsp; 0493</p>\r\n          <h1>Islamiyat</h1>\r\n          <p class=\"subtitle\">How a revelation spoken across twenty-three years became the single fixed text a billion and a half people recite today &mdash; and everything else the syllabus asks you to know, delivered as scored, Khan Academy&ndash;style lessons instead of a flat wall of text to re-read.</p>\r\n        </div>\r\n      </header>\r\n\r\n      <section class=\"wrap\" style=\"padding:clamp(40px,7vw,72px) 0;\">\r\n        <p class=\"eyebrow\">Choose a paper</p>\r\n        <h2 style=\"max-width:24ch;\">Two papers, eight topics, one course.</h2>\r\n        <div class=\"card-grid\">\r\n          <a class=\"entity-card\" href=\"paper-1/index.html\">\r\n            <div class=\"card-num\">01</div>\r\n            <h3>Paper 1</h3>\r\n            <p>The Qur&rsquo;an, its revelation and compilation, the Prophet Muhammad (pbuh), and the first Islamic community.</p>\r\n          </a>\r\n          <a class=\"entity-card\" href=\"paper-2/index.html\">\r\n            <div class=\"card-num\">02</div>\r\n            <h3>Paper 2</h3>\r\n            <p>The Hadiths, the Rightly Guided Caliphs, and the Articles of Faith &amp; Five Pillars of Islam.</p>\r\n          </a>\r\n        </div>\r\n      </section>\r\n\r\n      <section class=\"method\" id=\"method\">\r\n        <div class=\"wrap\">\r\n          <p class=\"eyebrow\">Before you start reading</p>\r\n          <h2 style=\"font-size:clamp(1.5rem,3vw,2rem); max-width:26ch;\">This course is built to be forgotten &mdash; on purpose.</h2>\r\n          <p class=\"prose-col\" style=\"color:var(--ink-soft); margin-top:14px;\">Re-reading a paragraph until it feels familiar is the least effective way to learn it, even though it <em>feels</em> productive. Cognitive scientists Peter Brown, Henry Roediger and Mark McDaniel spent a decade testing what actually works, and published it as <em>Make It Stick: The Science of Successful Learning</em>. Five of their findings are built directly into every lesson here &mdash; delivered through scored, Khan Academy&ndash;style quizzes rather than passive reading:</p>\r\n          <div class=\"method-grid\" style=\"margin-top:28px;\">\r\n            <div class=\"method-card\">\r\n              <div class=\"num\">01</div>\r\n              <h4>Retrieval practice</h4>\r\n              <p>Every few paragraphs you'll hit a <strong>Quick Check</strong> &mdash; a real multiple-choice question with instant feedback. Answering from memory, not re-reading, is what wires a fact in.</p>\r\n            </div>\r\n            <div class=\"method-card\">\r\n              <div class=\"num\">02</div>\r\n              <h4>Generation</h4>\r\n              <p>Lessons open with a question you can't yet answer. Guessing first &mdash; even wrongly &mdash; makes the correct answer, once you meet it, stick harder than if you'd just been told.</p>\r\n            </div>\r\n            <div class=\"method-card\">\r\n              <div class=\"num\">03</div>\r\n              <h4>Interleaving</h4>\r\n              <p>Each topic's <strong>Course Challenge</strong> mixes questions from every sub-topic in shuffled order, the way the real paper will, instead of drilling one topic in a block.</p>\r\n            </div>\r\n            <div class=\"method-card\">\r\n              <div class=\"num\">04</div>\r\n              <h4>Spaced retrieval</h4>\r\n              <p>Each topic's review planner schedules you to retest yourself on Day 1, 3, 7 and 16 &mdash; the intervals that convert short-term recall into long-term memory.</p>\r\n            </div>\r\n            <div class=\"method-card\">\r\n              <div class=\"num\">05</div>\r\n              <h4>Scored mastery + XP</h4>\r\n              <p>Every Quick Check and Unit Test earns XP toward your level. One question at a time, instant right/wrong feedback, and a final score that tells you honestly whether you've mastered it.</p>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>";
---

<CourseLayout title={title} page={page} footerHtml={footerHtml}>
  <main id="main" set:html={mainHtml} />
</CourseLayout>
