---
import CourseLayout from '../../../layouts/CourseLayout.astro';

const page = { page: "topic-index", paper: "paper-1", topic: "topic-2" };
const title = "Topic 2: The history and importance of the Qur’an · IGCSE Islamiyat";
const footerHtml = "Cambridge IGCSE Islamiyat 0493 &middot; Paper 1, Topic 2 &middot; Sources: Qur&rsquo;an, Sahih al-Bukhari, Sahih Muslim, Yasir Qadhi&rsquo;s <em>An Introduction to the Sciences of the Qur&rsquo;aan</em>, and the 2021&ndash;2025 past-paper archive";
const mainHtml = "<header class=\"hero\">\r\n        <div class=\"wrap\">\r\n          <p class=\"eyebrow\">Paper 1 &middot; Topic 2</p>\r\n          <h1>The history and importance of the Qur&rsquo;an</h1>\r\n          <p class=\"subtitle\">How a revelation spoken across twenty-three years, to one unlettered man in the hills above Makkah, became the single fixed text a billion and a half people recite today &mdash; and why examiners keep asking you to prove you understand how.</p>\r\n          <div class=\"hero-meta\">\r\n            <span class=\"chip\"><b>2.1</b> Revelation of the Qur&rsquo;an</span>\r\n            <span class=\"chip\"><b>2.2</b> Compilation under the Khalifas</span>\r\n            <span class=\"chip\"><b>2.3</b> The Qur&rsquo;an in Legal Thinking</span>\r\n            <span class=\"chip\">AO1 68% &middot; AO2 32%</span>\r\n          </div>\r\n        </div>\r\n      </header>\r\n\r\n      <section class=\"wrap\" style=\"padding:clamp(40px,7vw,60px) 0 0;\">\r\n        <p class=\"eyebrow\">Units</p>\r\n        <h2 style=\"max-width:26ch;\">Three units, each with its own Unit Test.</h2>\r\n        <div class=\"card-grid\" id=\"unitCards\"></div>\r\n      </section>\r\n\r\n      <section class=\"wrap\" style=\"padding:clamp(40px,6vw,56px) 0;\">\r\n        <div class=\"lesson-pager\">\r\n          <a class=\"pager-link next\" href=\"topic-challenge.html\"><span class=\"pg-label\">Finished all three units?</span><div class=\"pg-title\">Topic Challenge &mdash; mixed across 2.1, 2.2 &amp; 2.3</div></a>\r\n        </div>\r\n      </section>\r\n\r\n      <section class=\"planner\" id=\"planner\">\r\n        <div class=\"wrap\">\r\n          <p class=\"eyebrow\">Last step</p>\r\n          <h2 style=\"max-width:22ch;\">Come back on these four days &mdash; not just once.</h2>\r\n          <p class=\"lede prose-col\">A single study session, however thorough, fades fast. Testing yourself again at increasing intervals &mdash; a day later, a few days later, a week later, then two weeks later &mdash; is what moves knowledge from short-term recall into durable, exam-day memory. Tick a box as you complete each pass; your progress is saved on this device (and synced to your account if you're signed in).</p>\r\n          <table class=\"plan-table\">\r\n            <thead>\r\n              <tr><th>When</th><th>What to do</th><th>Done</th></tr>\r\n            </thead>\r\n            <tbody>\r\n              <tr>\r\n                <td class=\"day mono\">Today</td>\r\n                <td>Work through all three units in full: lesson, Practice Quiz, Quiz, then all three Unit Tests.</td>\r\n                <td><input type=\"checkbox\" data-plan=\"day0\" aria-label=\"Mark today's session complete\"></td>\r\n              </tr>\r\n              <tr>\r\n                <td class=\"day mono\">Day 1</td>\r\n                <td>Close the book. From memory, write the three triggers: the first revelation, Abu Bakr's compilation, &rsquo;Uthman's compilation. Then re-open and check.</td>\r\n                <td><input type=\"checkbox\" data-plan=\"day1\" aria-label=\"Mark day 1 review complete\"></td>\r\n              </tr>\r\n              <tr>\r\n                <td class=\"day mono\">Day 3</td>\r\n                <td>Retake all three Unit Tests without re-reading the lessons first. Note which one scored lowest.</td>\r\n                <td><input type=\"checkbox\" data-plan=\"day3\" aria-label=\"Mark day 3 review complete\"></td>\r\n              </tr>\r\n              <tr>\r\n                <td class=\"day mono\">Day 7</td>\r\n                <td>Write full model answers, from memory, to the past-paper questions in this topic. Time yourself at 15 minutes each.</td>\r\n                <td><input type=\"checkbox\" data-plan=\"day7\" aria-label=\"Mark day 7 review complete\"></td>\r\n              </tr>\r\n              <tr>\r\n                <td class=\"day mono\">Day 16</td>\r\n                <td>Final cold retrieval: take the Topic Challenge once more and aim to master it on the first attempt.</td>\r\n                <td><input type=\"checkbox\" data-plan=\"day16\" aria-label=\"Mark day 16 review complete\"></td>\r\n              </tr>\r\n            </tbody>\r\n          </table>\r\n          <button class=\"reset-planner\" id=\"resetPlanner\" type=\"button\">Reset planner</button>\r\n        </div>\r\n      </section>";
---

<CourseLayout title={title} page={page} footerHtml={footerHtml}>
  <main id="main" set:html={mainHtml} />
  <script is:inline slot="scripts">
function __pageScript(){
(function(){
  var mount = document.getElementById("unitCards");
  var topic = window.CONTENT_TREE.papers[0].topics.filter(function(t){ return t.id === "topic-2"; })[0];
  mount.innerHTML = topic.units.map(function(u){
    return '<a class="entity-card" href="' + window.ROOT + u.href + '">' +
      '<div class="card-num">' + u.num + '</div><h3>' + u.title + '</h3>' +
      '<p>' + u.lessons.length + ' lessons, each with a Practice Quiz and a graded Quiz.</p></a>';
  }).join("");
})();
}
if (window.CONTENT_TREE) __pageScript();
else window.addEventListener("islamiyat:ready", __pageScript, { once: true });
  </script>
</CourseLayout>
