---
import CourseLayout from '../../../../layouts/CourseLayout.astro';

const page = { page: "unit-test", paper: "paper-1", topic: "topic-2", unit: "2-2" };
const title = "Unit Test: 2.2 &middot; IGCSE Islamiyat";
const footerHtml = "Cambridge IGCSE Islamiyat 0493 &middot; Paper 1, Topic 2, Unit 2.2 &middot; Unit Test";
const mainHtml = "<section class=\"chapter\">\r\n        <div class=\"wrap\">\r\n          <div class=\"chapter-head\">\r\n            <h1 style=\"display:flex; align-items:baseline; gap:14px; flex-wrap:wrap;\">Unit Test &middot; 2.2 <span class=\"mastery-badge\" data-badge-for=\"unit-test--2-2\">Not started</span></h1>\r\n            <p class=\"ch-sub\">The Compilation under the Khalifas &middot; drawn from all 3 lessons in this unit &middot; score 80% or higher to master it</p>\r\n          </div>\r\n          <div class=\"quiz-mount\" data-quiz=\"unit-test--2-2\"></div>\r\n\r\n          <div class=\"lesson-pager\">\r\n            <a class=\"pager-link\" href=\"index.html\"><span class=\"pg-label\">&larr; Back</span><div class=\"pg-title\">Unit 2.2 overview</div></a>\r\n            <a class=\"pager-link next\" href=\"../index.html\"><span class=\"pg-label\">Next &rarr;</span><div class=\"pg-title\">Topic 2 overview</div></a>\r\n          </div>\r\n        </div>\r\n      </section>";
---

<CourseLayout title={title} page={page} footerHtml={footerHtml}>
  <main id="main" set:html={mainHtml} />
</CourseLayout>
