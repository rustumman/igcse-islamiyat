---
import CourseLayout from '../../../../layouts/CourseLayout.astro';

const page = { page: "unit-index", paper: "paper-1", topic: "topic-2", unit: "2-2" };
const title = "Unit 2.2 · The Compilation under the Khalifas · IGCSE Islamiyat";
const footerHtml = "Cambridge IGCSE Islamiyat 0493 &middot; Paper 1, Topic 2, Unit 2.2";
const mainHtml = "<header class=\"hero\">\r\n        <div class=\"wrap\">\r\n          <p class=\"eyebrow\">Paper 1 &middot; Topic 2</p>\r\n          <h1>Unit 2.2 &middot; The Compilation under the Khalifas</h1>\r\n          <p class=\"subtitle\">3 lessons, each with a Practice Quiz and a graded Quiz, then a Unit Test covering all of Unit 2.2.</p>\r\n        </div>\r\n      </header>\r\n      <section class=\"wrap\" style=\"padding:clamp(40px,7vw,60px) 0 0;\">\r\n        <p class=\"eyebrow\">Lessons</p>\r\n        <div class=\"lesson-row-list\" id=\"lessonRows\"></div>\r\n      </section>\r\n      <section class=\"wrap\" style=\"padding:clamp(40px,6vw,56px) 0;\">\r\n        <div class=\"lesson-pager\">\r\n          <a class=\"pager-link\" href=\"unit-test.html\"><span class=\"pg-label\">Ready for the whole unit?</span><div class=\"pg-title\">Unit Test &middot; 2.2</div></a>\r\n        </div>\r\n      </section>";
---

<CourseLayout title={title} page={page} footerHtml={footerHtml}>
  <main id="main" set:html={mainHtml} />
  <script is:inline slot="scripts">
function __pageScript(){
(function(){
  var mount = document.getElementById("lessonRows");
  var html = "";
  html += '<div class="lesson-row"><div class="lr-body"><h4>Preservation Before Compilation</h4></div>' +
    '<div class="lr-actions"><a class="lr-btn" href="' + window.ROOT + "paper-1/topic-2/2-2/preservation-before-compilation/lesson.html" + '">Lesson</a>' +
    '<a class="lr-btn" href="' + window.ROOT + "paper-1/topic-2/2-2/preservation-before-compilation/practice.html" + '">Practice</a>' +
    '<a class="lr-btn" href="' + window.ROOT + "paper-1/topic-2/2-2/preservation-before-compilation/quiz.html" + '">Quiz</a></div></div>';

  html += '<div class="lesson-row"><div class="lr-body"><h4>Compilation under Abu Bakr</h4></div>' +
    '<div class="lr-actions"><a class="lr-btn" href="' + window.ROOT + "paper-1/topic-2/2-2/compilation-under-abu-bakr/lesson.html" + '">Lesson</a>' +
    '<a class="lr-btn" href="' + window.ROOT + "paper-1/topic-2/2-2/compilation-under-abu-bakr/practice.html" + '">Practice</a>' +
    '<a class="lr-btn" href="' + window.ROOT + "paper-1/topic-2/2-2/compilation-under-abu-bakr/quiz.html" + '">Quiz</a></div></div>';

  html += '<div class="lesson-row"><div class="lr-body"><h4>Compilation under ’Uthman</h4></div>' +
    '<div class="lr-actions"><a class="lr-btn" href="' + window.ROOT + "paper-1/topic-2/2-2/compilation-under-uthman/lesson.html" + '">Lesson</a>' +
    '<a class="lr-btn" href="' + window.ROOT + "paper-1/topic-2/2-2/compilation-under-uthman/practice.html" + '">Practice</a>' +
    '<a class="lr-btn" href="' + window.ROOT + "paper-1/topic-2/2-2/compilation-under-uthman/quiz.html" + '">Quiz</a></div></div>';

  mount.innerHTML = html;
})();
}
if (window.CONTENT_TREE) __pageScript();
else window.addEventListener("islamiyat:ready", __pageScript, { once: true });
  </script>
</CourseLayout>
