---
import CourseLayout from '../../../layouts/CourseLayout.astro';

const page = { page: "topic-challenge", paper: "paper-1", topic: "topic-2" };
const title = "Topic Challenge · Topic 2 · IGCSE Islamiyat";
const footerHtml = "Cambridge IGCSE Islamiyat 0493 &middot; Paper 1, Topic 2 &middot; Topic Challenge";
const mainHtml = "<section class=\"challenge-band\">\r\n        <div class=\"wrap\">\r\n          <p class=\"eyebrow\" style=\"color:#e8c77a;\">Topic challenge &middot; mixed order, on purpose</p>\r\n          <h1 style=\"max-width:22ch; display:flex; align-items:baseline; gap:14px; flex-wrap:wrap;\">The real exam won't ask about one unit at a time. Neither will this. <span class=\"mastery-badge\" data-badge-for=\"topic-challenge--topic-2\" style=\"color:#e3e1d4; border-color:rgba(255,255,255,.3);\">Not started</span></h1>\r\n          <p class=\"lede\" style=\"max-width:60ch;\">Questions drawn from every lesson across Units 2.1, 2.2 and 2.3, in shuffled order every time you take it. Interleaving like this feels harder than reviewing one unit in a block &mdash; that's the desirable difficulty at work, and it's the closest rehearsal you can do for how the actual paper mixes its questions. Score 80% or higher to master the whole topic.</p>\r\n          <div class=\"quiz-mount\" data-quiz=\"topic-challenge--topic-2\" style=\"margin-top:32px; max-width:70ch;\"></div>\r\n        </div>\r\n      </section>\r\n\r\n      <div class=\"wrap\">\r\n        <div class=\"lesson-pager\">\r\n          <a class=\"pager-link\" href=\"2-3/unit-test.html\"><span class=\"pg-label\">&larr; Back</span><div class=\"pg-title\">Unit Test &middot; 2.3</div></a>\r\n          <a class=\"pager-link next\" href=\"index.html\"><span class=\"pg-label\">Next &rarr;</span><div class=\"pg-title\">Topic 2 overview &amp; review planner</div></a>\r\n        </div>\r\n      </div>";
---

<CourseLayout title={title} page={page} footerHtml={footerHtml}>
  <main id="main" set:html={mainHtml} />
</CourseLayout>
