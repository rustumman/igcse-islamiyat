---
import CourseLayout from '../../layouts/CourseLayout.astro';

const page = { page: "paper-index", paper: "paper-1" };
const title = "Paper 1 &middot; IGCSE Islamiyat";
const footerHtml = "Cambridge IGCSE Islamiyat 0493 &middot; Paper 1";
const mainHtml = "<header class=\"hero\">\r\n        <div class=\"wrap\">\r\n          <p class=\"eyebrow\">Cambridge IGCSE Islamiyat 0493</p>\r\n          <h1>Paper 1</h1>\r\n          <p class=\"subtitle\">The Qur&rsquo;an, the Prophet Muhammad (pbuh), and the first Islamic community &mdash; four topics, examined in a 1 hour 30 minute written paper.</p>\r\n        </div>\r\n      </header>\r\n\r\n      <section class=\"wrap\" style=\"padding:clamp(40px,7vw,72px) 0;\">\r\n        <p class=\"eyebrow\">Topics</p>\r\n        <h2 style=\"max-width:26ch;\">Start with Topic 2 &mdash; it's the one that's ready.</h2>\r\n        <div class=\"card-grid\" id=\"topicCards\"></div>\r\n      </section>\r\n\r\n      <section class=\"wrap\" style=\"padding:0 0 clamp(40px,6vw,56px);\">\r\n        <div class=\"lesson-pager\">\r\n          <a class=\"pager-link next\" href=\"paper-challenge.html\"><span class=\"pg-label\">Confident across every built topic?</span><div class=\"pg-title\">Paper Challenge &mdash; mixed across all of Paper 1</div></a>\r\n        </div>\r\n      </section>";
---

<CourseLayout title={title} page={page} footerHtml={footerHtml}>
  <main id="main" set:html={mainHtml} />
</CourseLayout>
