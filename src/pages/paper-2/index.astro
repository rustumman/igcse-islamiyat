---
import CourseLayout from '../../layouts/CourseLayout.astro';

const page = { page: "paper-index", paper: "paper-2" };
const title = "Paper 2 · IGCSE Islamiyat";
const footerHtml = "Cambridge IGCSE Islamiyat 0493 &middot; Paper 2";
const mainHtml = "<header class=\"hero\">\r\n        <div class=\"wrap\">\r\n          <p class=\"eyebrow\">Cambridge IGCSE Islamiyat 0493</p>\r\n          <h1>Paper 2</h1>\r\n          <p class=\"subtitle\">The Hadiths, the Rightly Guided Caliphs, and the Articles of Faith &amp; Five Pillars of Islam.</p>\r\n        </div>\r\n      </header>\r\n\r\n      <section class=\"wrap\" style=\"padding:clamp(40px,7vw,72px) 0;\">\r\n        <p class=\"eyebrow\">Topics</p>\r\n        <h2 style=\"max-width:26ch;\">Not built yet &mdash; Paper 1, Topic 2 is where to start.</h2>\r\n        <div class=\"card-grid\" id=\"topicCards\"></div>\r\n      </section>";
---

<CourseLayout title={title} page={page} footerHtml={footerHtml}>
  <main id="main" set:html={mainHtml} />
  <script is:inline slot="scripts">
function __pageScript(){
(function(){
  var mount = document.getElementById("topicCards");
  var paper = window.CONTENT_TREE.papers.filter(function(p){ return p.id === "paper-2"; })[0];
  mount.innerHTML = paper.topics.map(function(t){
    return '<div class="entity-card soon"><span class="soon-badge">Coming soon</span>' +
      '<div class="card-num">' + t.num + '</div><h3>' + t.title + '</h3><p></p></div>';
  }).join("");
})();
}
if (window.CONTENT_TREE) __pageScript();
else window.addEventListener("islamiyat:ready", __pageScript, { once: true });
  </script>
</CourseLayout>
